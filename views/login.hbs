<!DOCTYPE html>
<html lang="es">
<head>
 <meta charset="UTF-8">
 <title>Login - Administración</title>
 <style>
 body { font-family: Arial, sans-serif; background-color: #f4f4f4; margin: 50px; }
 .card { background: white; padding: 30px; border-radius: 8px; max-width: 350px; margin: auto; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
 .form-group { margin-bottom: 15px; }
 label { display: block; margin-bottom: 5px; font-weight: bold; }
 input[type="text"], input[type="password"] { width: 100%; padding: 8px; box-sizing: border-box; }
 button { width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; }
 .error { color: red; margin-top: 15px; text-align: center; }
 </style>
</head>
<body>
 <div class="card">
 <h2>Iniciar Sesión</h2>
 <form action="/login" method="post">
 <div class="form-group">
 <label for="usuario">Usuario:</label>
 <input type="text" id="usuario" name="usuario" required placeholder="Ej: flavia">
 </div>
 <div class="form-group">
 <label for="password">Contraseña:</label>
 <input type="password" id="password" name="password" required placeholder="Ej: 1234">
 </div>
 <button type="submit">Ingresar</button>
 </form>
 {{#if error}}
 <p class="error">Usuario o contraseña incorrectos</p>
 {{/if}}
 </div>
</body>
</html>
